node_modules
dist
dist-ssr
*.local
.vite

# Build output
target
src-tauri/target
src-tauri/gen

# `tsc -b` emits these from tsconfig.node.json's project reference. They are
# regenerated by every build, so they do not belong in history.
*.tsbuildinfo
vite.config.js
vite.config.d.ts

# Signing material. The updater keypair has no second copy anywhere — back it up
# outside the repo. The certificate patterns are here because a code-signing
# export lands in the project root by default, and a key committed once is a key
# that has to be rotated.
.updater-keys/
*.p12
*.pfx
*.pem
*.key
*.cer
*.mobileprovision

# Editor / tooling
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
# No pattern here for the macOS custom-folder-icon sidecar. The usual one,
# `Icon*`, has no slash, so it matches at every level, and the checkout is
# case-insensitive: it was quietly keeping both src-tauri/icons/ and
# src/components/ui/icons.ts out of the repository. A fresh clone would
# have had no icon barrel and no bundle icons. The sidecar's real name ends
# in a carriage return, which cannot be written in this file at all (git
# strips a trailing CR from every line), and it only exists if someone sets
# a folder icon by hand. Not worth the trade.
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
